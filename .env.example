# Server bind address. Keep on loopback/Tailscale interface unless you front it with TLS.
# TGB_LISTEN=127.0.0.1:8080

# Path to TOML config file (default: ./config/tg-bridge.toml)
# TGB_CONFIG=config/tg-bridge.toml

# RUST_LOG=info

# --- Per-client secrets (referenced from config via env:) ---
# TGB_CLIENT_SALUT66_SECRET=change-me-64-hex-chars

# --- Bot tokens (never leave this host) ---
# TGB_BOT_SALUT_TOKEN=123456:ABC...
