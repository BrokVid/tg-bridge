# TLS-фронт для Tg Bridge (caddy, пример)
# Caddy сам получает и продлевает сертификат Let's Encrypt.
# Клиенты ходят на https://bridge.example.com, мост слушает 127.0.0.1:8080.

bridge.example.com {
	# HTTP/2 и TLS включены по умолчанию.
	reverse_proxy 127.0.0.1:8080

	# Апдейты вебхука могут быть до 64 КБ; лимит тела поднимите при
	# необходимости отправки файлов через мост:
	request_body {
		max_size 64MB
	}
}
