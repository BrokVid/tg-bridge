# /etc/systemd/system/tg-demo.service
[Unit]
Description=Tg Bridge test client (demo bot)
After=network-online.target
Wants=network-online.target

[Service]
User=tg-demo
Group=tg-demo
EnvironmentFile=/etc/tg-demo/env
ExecStart=/usr/bin/python3 /opt/tg-bridge/demo_bot.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
